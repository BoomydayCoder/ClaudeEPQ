N := 120000;
// merge sort of [key, tag] pairs using EPQ's lexicographic list comparison
mod := (a, b) => { => a - b * (a / b); };
merge := (a, b) => {
    i := 0; j := 0; out := [];
    (i < |a| & j < |b|) @ {
        (b[j] < a[i]) ? { out :+ b[j]; j := j + 1; } : { out :+ a[i]; i := i + 1; }
    }
    (i < |a|) @ { out :+ a[i]; i := i + 1; }
    (j < |b|) @ { out :+ b[j]; j := j + 1; }
    => out;
};
sort := (l) => {
    (|l| <= 1) ? => l;
    mid := |l| / 2;
    left := []; right := [];
    (i := 0; i < mid; i := i + 1;) @ left :+ l[i];
    (i := mid; i < |l|; i := i + 1;) @ right :+ l[i];
    => merge(sort(left), sort(right));
};
data := [];
s := 3;
(i := 0; i < N; i := i + 1;) @ { s := mod(s * 75 + 74, 65537); data :+ [mod(s, 100), [mod(s, 7), i]]; }
r := sort(data);
ok := 1;
(i := 1; i < |r|; i := i + 1;) @ (r[i] < r[i - 1]) ? ok := 0;
>> ok;
>> [r[0], r[|r| / 3], r[|r| - 1]];
