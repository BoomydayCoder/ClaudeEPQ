N := 24;
// Takeuchi function plus Ackermann(2, n) / (3, n): deep, call-heavy recursion
tak := (x, y, z) => {
    (y < x) ? => tak(tak(x - 1, y, z), tak(y - 1, z, x), tak(z - 1, x, y));
    => z;
};
ack := (m, n) => {
    (m = 0) ? => n + 1;
    (n = 0) ? => ack(m - 1, 1);
    => ack(m - 1, ack(m, n - 1));
};
>> tak(N, N / 2 + 1, N / 4);
>> ack(2, 300);
>> ack(3, 8);
