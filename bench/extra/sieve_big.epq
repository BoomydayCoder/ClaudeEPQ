N := 6000000;
// sieve of Eratosthenes at a larger n; prints count and (wrapping) sum of primes
s := [0, 0];
(i := 2; i <= N; i := i + 1;) @ s :+ 1;
cnt := 0;
sum := 0;
(i := 2; i <= N; i := i + 1;) @ (s[i]) ? {
    cnt := cnt + 1;
    sum := sum + i;
    (i <= N / i) ? (j := i * i; j <= N; j := j + i;) @ s[j] := 0;
}
>> cnt;
>> sum;
