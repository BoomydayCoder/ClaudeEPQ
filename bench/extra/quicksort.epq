N := 300000;
// in-place recursive quicksort (Lomuto, middle pivot) of an LCG-generated list
mod := (a, b) => { => a - b * (a / b); };
gen := (n, seed) => {
    out := [];
    s := seed;
    (i := 0; i < n; i := i + 1;) @ {
        s := s * 1103515245 + 12345;
        out :+ mod(s / 65536, 1000000);
    }
    => out;
};
swap := (l, i, j) => { t := l[i]; l[i] := l[j]; l[j] := t; };
qs := (l, lo, hi) => {
    (lo >= hi) ? => 0;
    swap(l, (lo + hi) / 2, hi);
    p := l[hi];
    k := lo;
    (j := lo; j < hi; j := j + 1;) @ (l[j] < p) ? { swap(l, k, j); k := k + 1; }
    swap(l, k, hi);
    qs(l, lo, k - 1);
    qs(l, k + 1, hi);
};
data := gen(N, 42);
qs(data, 0, |data| - 1);
ok := 1;
chk := 0;
(i := 0; i < |data|; i := i + 1;) @ {
    (i > 0) ? (data[i - 1] > data[i]) ? ok := 0;
    chk := chk * 31 + data[i];
}
>> ok;
>> chk;
>> [data[0], data[|data| / 2], data[|data| - 1]];
