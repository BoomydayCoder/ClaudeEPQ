// pairs x records: a pair-shaped list stored as a record field, replaced, compared
mk := (a, b) => { => [a, b]; };
p := mk(3, 4);
r := [1, p];
>> r;
>> r[1][0] + r[1][1];
q := [7, 8];
r[1] := q;
>> r;
>> r[1] = [7, 8];
>> r[1] < [7, 9];
s := [r, [0, [5, 6]]];
>> s;
>> s[0] < s[1];
>> s[1][1] = q;
q[0] := 5;
>> r;
