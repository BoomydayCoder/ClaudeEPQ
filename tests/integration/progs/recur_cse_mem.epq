// recur CSE x records: equal pure calls whose arguments read mutable memory (RecGet, Len, globals) must not merge across a store
sq := (n) => { (n < 1) ? => 0; => n * n + sq(n - 1) - sq(n - 1) + sq(n - 1) - sq(n - 1); };
ap := (q) => { q :+ 5; => 0; };
l := [1, 2, 3];
s := sq(|l|) + ap(l) + sq(|l|);
>> s;
f := () => { lf := [1, 2]; => sq(|lf|) + (lf :+ 7)[0] + sq(|lf|); };
>> f();
r := [1, [2]];
t := sq(r[0]) + (r[0] := 4) + sq(r[0]);
>> t;
w := [5, 6];
u := sq(w[0]) + (w[0] := 1) + sq(w[0]);
>> u;
g := 3;
setg := (v) => { g := v; => 0; };
>> sq(g) + setg(5) + sq(g);
dd := [1, 2];
ee := [dd, 9];
ap2 := (q2) => { q2 :+ 1; => 0; };
>> sq(|ee[0]|) + ap2(ee[0]) + sq(|ee[0]|);
