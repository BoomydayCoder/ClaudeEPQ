// ifconv: an established in-bounds read must not survive a list shrink (inlined pop / call)
popper := (l) => { => -l; };
data := [5, 3, 8, 1];
best := 0;
(j := 0; j < 4; j := j + 1;) @ {
  v := data[j];
  (j = 3) ? popper(data);
  (v > 100) ? best := data[j];
}
>> best;
>> data;
rpop := (l, n) => { (n = 0) ? => 0; x := -l; => rpop(l, n - 1); };
d2 := [4, 7, 1, 9];
b2 := 0;
(k := 0; k < |d2|; k := k + 1;) @ {
  v2 := d2[k];
  (k = 2) ? rpop(d2, 2);
  (v2 > 100) ? b2 := d2[k];
  (v2 > 5) ? b2 := b2 + v2;
}
>> b2;
>> d2;
d3 := [1, 2, 3];
(g := 0; g < 3; g := g + 1;) @ { u := d3[g]; (g = 1) ? popper(d3); (u > 0) ? b2 := d3[g]; }
>> b2;
