// reclaim x appendopt x records, in recursive (never inlined) functions
cp := (src, d) => { (d > 0) ? { zz := cp(src, d - 1); } out := []; (i := 0; i < |src|; i := i + 1;) @ out :+ src[i]; => out; };
inner := (k, d) => { (d > 0) ? { zz := inner(k, d - 1); } t := [[k], [k + 1], [k + 2]]; c := cp(t, 1); => c; };
a := inner(1, 2);
b := inner(10, 1);
>> a;
>> b;
a[0][0] := 99;
>> a;
>> b;
mkrec := (n, d) => { (d > 0) ? { zz := mkrec(n, d - 1); } l := [n, n + 1]; rr := [0, l]; => rr; };
setrec := (n, d) => { (d > 0) ? { zz := setrec(n, d - 1); } l2 := [n, n * 2]; r2 := [0, [9]]; r2[1] := l2; => r2; };
x := mkrec(5, 2);
z := setrec(3, 2);
>> x;
>> z;
>> x[1][1] + z[1][1];
halves := (l, d) => {
  (|l| < 2 | d = 0) ? => l;
  lo := []; hi := [];
  (i := 0; i < |l| / 2; i := i + 1;) @ lo :+ l[i];
  (j := |l| / 2; j < |l|; j := j + 1;) @ hi :+ l[j];
  r1 := halves(lo, d - 1); r2 := halves(hi, d - 1);
  out := [];
  (y : r2) @ out :+ y;
  (y2 : r1) @ out :+ y2;
  => out;
};
>> halves([1, 2, 3, 4, 5, 6, 7, 8, 9], 5);
pl := [[1, 2], [3, 4], [5, 6]];
>> halves(pl, 3);
>> pl;
