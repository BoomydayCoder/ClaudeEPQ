// Typed record comparisons (JIT rec_eq / rec_cmp3 stubs): field kinds, nesting, null.
mk := (k, t) => { => [k, [t, k + 1]]; };
a := mk(1, 2); b := mk(1, 3); c := mk(0, 9); d := mk(1, 2);
>> a < b; >> b < a; >> a = d; >> a != b; >> c < a; >> a <= d; >> a >= b; >> a > c;
// cons lists (nullable records)
cons := (h, t) => { => [h, t]; };
l1 := cons(1, cons(2, cons(3, [])));
l2 := cons(1, cons(2, []));
l3 := cons(1, cons(2, cons(3, [])));
>> l1 < l2; >> l2 < l1; >> l1 = l3; >> l1 = l2; >> [] = l1; >> l2 > [];
e := [];
>> e = [];
// pair-like fields and functions
f := (x) => { => x; };
r1 := [1, f, 2]; r2 := [1, f, 3];
>> r1 = r2; >> r1 = [1, f, 2];
// any field
q1 := [1, 2]; q1[1] := [5];
q2 := [1, [5]];
>> q2 = q1;
// invalid comparison inside a record
>> r1 < r2;
