// DynIsEmptyList (litcmp) in value and branch form, Any operands of every kind.
g := (y) => { => y; };
d := [[1], 2, [], g, [[]], [], 0, -1];
n := 0;
(e : d) @ {
  (e = []) ? { n := n + 1; >> 1; } : { >> 0; }
  (e != []) ? >> 10;
  t := e = [];
  u := [] != e;
  >> t + 2 * u;
  ((e = []) & (n > 1)) ? >> 100;
  ((e = []) | (n = 0)) ? >> 200;
  (!(e = [])) ? >> 300;
}
>> n;
i := 0;
c := [[], [], [3]];
(i < 3) @ { k := c[i]; (k = []) ? >> i; i := i + 1; }
