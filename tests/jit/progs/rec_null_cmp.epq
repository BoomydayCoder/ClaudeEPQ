// Nullable records (cons lists built by recursion) in equality / ordering.
step := (s, n) => {
    (n = 0) ? => s;
    => step([s[0] + n, [n, s[1]]], n - 1);
};
a := step([0, []], 4);
b := step([0, []], 4);
c := step([0, []], 3);
d := step([1, []], 3);
>> a = b; >> a != b; >> a < b; >> a <= b;
>> a[1] = b[1]; >> a[1] < c[1]; >> c[1] < a[1]; >> a[1] > c[1];
>> a < c; >> c < a; >> c < d; >> d > c; >> d = c;
e := a[1]; f := e[1]; g := f[1]; h := g[1]; z := h[1];
>> z = []; >> z < h; >> h < z; >> z <= z; >> [] < z;
>> a[1] = [4, [3, [2, [1, []]]]];
