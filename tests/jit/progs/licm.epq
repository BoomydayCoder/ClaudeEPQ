// Loop-invariant arithmetic hoisted to the loop entry (JIT), constants in registers.
n := 7; m := 3; big := 2147483647;
s := 0;
(i := 0; i < n * m - 2; i := i + 1;) @ { s := s + (n - m - 1) * i; }
>> s;
(i := 0; i < n - m - 10; i := i + 1;) @ { >> 999; }
t := 0;
(i := 0; i < n; i := i + 1;) @ {
  (j := 0; j < n - i - 1; j := j + 1;) @ { t := t + (big + big) * (m + 1); }
  m := m + 1;
}
>> t; >> m;
k := 0; u := 0;
(k < 50000) @ { u := u + (k > 3 * n + 1) * (n * 1000 + 5); k := k + 1; (k = 10) ? n := n + 1; }
>> u;
f := (a, b) => { r := 0; (i := 0; i < a * b + a; i := i + 1;) @ { (i > a + b * 2) ? r := r + (a - b) * (a + b); } => r; };
>> f(5, 3); >> f(0, 0); >> f(-3, 2);
c := 0; x := 123456;
(i := 0; i < 70000; i := i + 1;) @ { (i * 5 > 100000) ? c := c + 1; x := x * 1664525 + 1013904223; }
>> c; >> x;
