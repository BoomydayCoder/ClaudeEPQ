// an empty global that is a tree in one phase and a growing list in another (separate globals)
ins := (t, v) => {
    (t = []) ? => [v, [], []];
    (v < t[0]) ? t[1] := ins(t[1], v); : (v > t[0]) ? t[2] := ins(t[2], v);
    => t;
};
walk := (t) => { (t = []) ? => 0; => walk(t[1]) + 1 + walk(t[2]); };
tree := [];
(i := 0; i < 50; i := i + 1;) @ tree := ins(tree, (i * 17) - (i * 17) / 31 * 31);
>> walk(tree);
lst := [];
(i := 0; i < 10; i := i + 1;) @ lst :+ walk(tree) + i;
>> lst;
tree := [];
>> walk(tree);
tree := ins(tree, 1);
>> tree;
