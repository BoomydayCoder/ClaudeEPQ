// cons lists and trees with [] as empty
cons := (h, t) => { => [h, t]; };
len := (c) => { n := 0; (c != []) @ { n := n + 1; c := c[1]; } => n; };
cl := [];
(i := 0; i < 5; i := i + 1;) @ cl := cons([i, [i]], cl);
>> cl;
>> len(cl);
>> cl = [];
>> |cl[1][1]|;
ins := (t, v) => {
    (|t| = 0) ? => [v, [], []];
    (v < t[0]) ? t[1] := ins(t[1], v); : t[2] := ins(t[2], v);
    => t;
};
tr := [];
(i := 0; i < 6; i := i + 1;) @ tr := ins(tr, (i * 5) - (i * 5) / 7 * 7);
>> tr;
>> tr[1] = [];
>> tr < [3];
>> [] < tr;
>> tr[1][1][1];
