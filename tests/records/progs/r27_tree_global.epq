// BST from a global empty tree: insert / contains / size / height / in-order
ins := (t, v) => {
    (t = []) ? => [v, [], []];
    (v < t[0]) ? t[1] := ins(t[1], v); : (v > t[0]) ? t[2] := ins(t[2], v);
    => t;
};
has := (t, v) => {
    (t != []) @ {
        (v = t[0]) ? => 1;
        (v < t[0]) ? t := t[1]; : t := t[2];
    }
    => 0;
};
size := (t) => { (|t| = 0) ? => 0; => 1 + size(t[1]) + size(t[2]); };
height := (t) => { (|t| = 0) ? => 0; a := height(t[1]); b := height(t[2]); (a > b) ? => a + 1; => b + 1; };
out := [];
inorder := (t) => { (t != []) ? { inorder(t[1]); out :+ t[0]; inorder(t[2]); } => 0; };
tree := [];
s := 7;
(i := 0; i < 200; i := i + 1;) @ { s := (s * 75 + 74) - (s * 75 + 74) / 65537 * 65537; tree := ins(tree, s - s / 1000 * 1000); }
>> size(tree);
>> height(tree);
h := 0;
(i := 0; i < 1000; i := i + 1;) @ h := h + has(tree, i);
>> h;
inorder(tree);
>> |out|;
>> [out[0], out[1], out[|out| - 1]];
small := [];
small := ins(small, 2); small := ins(small, 1); small := ins(small, 3);
>> small;
>> small = [2, [1, [], []], [3, [], []]];
>> small < [2, [1, [], [0]]];
>> [] < small;
>> small[1][1] = [];
>> |small[2][2]|;
>> |small|;
