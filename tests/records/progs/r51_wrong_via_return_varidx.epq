// a node returned from a function is indexed with a variable far away
ins := (t, v) => {
    (t = []) ? => [v, [], []];
    (v < t[0]) ? t[1] := ins(t[1], v); : (v > t[0]) ? t[2] := ins(t[2], v);
    => t;
};
tree := [];
(i := 0; i < 5; i := i + 1;) @ tree := ins(tree, i * 2 - i * i / 3);
left := (t) => { (t[1] = []) ? => t; => left(t[1]); };
m := left(tree);
k := 0;
(i := 0; i < 3; i := i + 1;) @ { >> m[k]; k := k + 1; }
>> tree;
