add := (a, b) => { => a + b; };
mul := (a, b) => { => a * b; };
ops := [add, mul];
>> ops[0](3, 4); >> ops[1](3, 4);
pick := (i) => { => ops[i]; };
>> pick(1)(5, 6);
>> add = add; >> add = mul; >> ops[0] = add; >> [add] = [add]; >> [add] = [mul];
apply := (f) => { => f(2, 3); };
>> apply(add) + apply(mul);
ops :+ (x) => { => x; };
>> |ops|;
>> ops[2](9);
k := (x) => { => x; };
>> k = k; >> k = 1; >> k = [k];
