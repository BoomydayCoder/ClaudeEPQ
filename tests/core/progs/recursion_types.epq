depth := (l) => { (|l| = 0) ? => 0; => 1 + depth(l[0]); };
>> depth([]); >> depth([[]]); >> depth([[[[]]]]);
even := (n) => { (n = 0) ? => 1; => odd(n - 1); };
odd := (n) => { (n = 0) ? => 0; => even(n - 1); };
>> even(10); >> odd(7);
build := (n) => { (n = 0) ? => []; => [build(n - 1)]; };
>> build(3);
f := (x, n) => { (n = 0) ? => x; => g([x], n - 1); };
g := (x, n) => { => f(x, n); };
>> f(1, 3); >> f([2], 2);
