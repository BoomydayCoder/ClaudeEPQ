f := (x) => { => x; };
g := (x) => { => x; };
>> f = f;
>> f = g;
>> [f] = [f];
>> [f] = [g];
>> [f, 1] = [f, 1];
a := f;
>> a = f;
a := g;
>> a = f;
>> a = g;
b := [f, g, 1];
>> b[0] = f;
>> b[1] = g;
>> b[0] != b[1];
>> f != 3;
>> [] = [f];
mk := () => { => (y) => { => y + 1; }; };
>> mk() = mk();
>> mk()(3);
