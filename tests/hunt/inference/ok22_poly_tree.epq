r := (x) => { => [x]; };
a := (x) => { => [r(x), r([x])]; };
b := (x) => { => [a(x), a([x]), a(r(x))]; };
c := (x) => { => [b(x), b([x]), b(a(x))]; };
d := (x) => { => [c(x), c([x]), c(b(x))]; };
e := (x) => { => [d(x), d([x]), d(c(x))]; };
>> |e(1)|;
z := e([2]);
>> z[0][0][0][0][0];
>> |z[2][2][2][2][1]|;
q := e(r(0));
>> q[1][1][1][1][1];
>> |b(1)|;
>> b(1);
