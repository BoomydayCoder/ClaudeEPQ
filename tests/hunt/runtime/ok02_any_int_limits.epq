// dynamic (Any) arithmetic

a := [2147483647, [], -2147483648, 1, -1, 0];
x := a[0]; y := a[2];
>> x + 1; >> y - 1; >> x * x; >> y * y; >> y / a[4]; >> -y; >> |y|; >> y * a[4];
>> x + y; >> y < x; >> x < y; >> y <= a[2]; >> x >= a[0]; >> y = -2147483648; >> -2147483648 = y;
g := (p, q) => { => p * q + p - q; };
>> g(x, y); >> g(y, y); >> g(a[3], a[1] = a[1]); >> g(65536, a[0]);
h := (p) => { => p / -1; };
>> h(y); >> h(a[0]); >> h(7);
z := a; z := 5; >> z + x;
