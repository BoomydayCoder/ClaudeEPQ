l := []; s := 0;
(n := 1; n < 70000; n := n * 3 + 1;) @ {
  (i := |l|; i < n; i := i + 1;) @ l :+ i;
  (|l| > n / 2) @ s := s + -l;
  >> [n, |l|, s];
}
(|l| > 0) @ -l; >> l; l :+ 9; >> l; >> -l; >> l;
w := [[]]; e := w[0]; (i := 0; i < 1000; i := i + 1;) @ { e :+ [i]; } (i := 0; i < 999; i := i + 1;) @ -e; >> w;
