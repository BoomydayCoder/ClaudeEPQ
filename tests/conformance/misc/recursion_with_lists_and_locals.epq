perms := (l) => {
    (|l| <= 1) ? => [l];
    out := [];
    (i := 0; i < |l|; i := i + 1;) @ {
        rest := [];
        (j := 0; j < |l|; j := j + 1;) @ (j != i) ? rest :+ l[j];
        (p : perms(rest)) @ { q := [l[i]]; (x : p) @ q :+ x; out :+ q; }
    }
    => out;
};
>> perms([1, 2, 3]);
>> |perms([1, 2, 3, 4, 5])|;
