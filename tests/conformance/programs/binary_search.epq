bsearch := (l, v) => {
    lo := 0; hi := |l| - 1;
    (lo <= hi) @ {
        mid := (lo + hi) / 2;
        (l[mid] = v) ? => mid;
        (l[mid] < v) ? lo := mid + 1; : hi := mid - 1;
    }
    => -1;
};
data := [];
(i := 0; i < 50; i := i + 1;) @ data :+ i * 3;
>> [bsearch(data, 0), bsearch(data, 42), bsearch(data, 147), bsearch(data, 43), bsearch(data, -3), bsearch([], 1)];
words := [[1], [1, 2], [2], [2, 0], [3, 1, 1]];
>> [bsearch(words, [2]), bsearch(words, [3, 1, 1]), bsearch(words, [0])];
