sieve := (n) => {
    is := [];
    (i := 0; i <= n; i := i + 1;) @ is :+ 1;
    is[0] := 0; is[1] := 0;
    (i := 2; i * i <= n; i := i + 1;) @ (is[i]) ? (j := i * i; j <= n; j := j + i;) @ is[j] := 0;
    out := [];
    (i := 0; i <= n; i := i + 1;) @ (is[i]) ? out :+ i;
    => out;
};
>> sieve(60);
>> |sieve(10000)|;
