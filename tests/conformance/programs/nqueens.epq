ok := (cols, r, c) => {
    (i := 0; i < r; i := i + 1;) @ {
        ci := cols[i];
        (ci = c | ci - c = r - i | c - ci = r - i) ? => 0;
    }
    => 1;
};
solve := (n, r, cols) => {
    (r = n) ? => 1;
    cnt := 0;
    (c := 0; c < n; c := c + 1;) @ (ok(cols, r, c)) ? {
        cols :+ c;
        cnt := cnt + solve(n, r + 1, cols);
        -cols;
    }
    => cnt;
};
(n := 1; n <= 7; n := n + 1;) @ >> [n, solve(n, 0, [])];
