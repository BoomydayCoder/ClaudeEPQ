insert := (l, v) => {
    out := []; done := 0;
    (x : l) @ { (!done & v < x) ? { out :+ v; done := 1; } out :+ x; }
    (!done) ? out :+ v;
    => out;
};
isort := (l) => { r := []; (x : l) @ r := insert(r, x); => r; };
>> isort([3, 1, 2]);
>> isort([[2], [1, 1], [1], []]);
>> isort([[[3]], [[1], [2]], [[1]]]);
