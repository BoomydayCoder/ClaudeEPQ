map := (f, l) => { out := []; (x : l) @ out :+ f(x); => out; };
filter := (p, l) => { out := []; (x : l) @ (p(x)) ? out :+ x; => out; };
sq := (x) => { => x * x; };
odd := (x) => { => x - x / 2 * 2; };
>> map(sq, [1, 2, 3, 4]);
>> filter(odd, [1, 2, 3, 4, 5]);
>> map((l) => { => |l|; }, [[], [1], [1, 2]]);
