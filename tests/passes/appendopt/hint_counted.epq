// counted loops with Reserve hints: <, <=, step > 1, several appends per iteration, early exit
a := [];
(i := 0; i <= 10; i := i + 1;) @ { a :+ i; }
>> a;
b := [];
c := [];
(i := 3; i < 20; i := i + 3;) @ { b :+ i; c :+ i; b :+ -i; }
>> b;
>> c;
f := () => {
  pl := [];
  (i := 0; i < 2000000000; i := i + 1;) @ { pl :+ i; (i = 4) ? => pl; }
  => pl;
};
>> f();
g := (pn) => {
  pl := [];
  (i := 0; i < pn; i := i + 1;) @ { pl :+ i; }
  => |pl|;
};
>> g(-2147483647);
>> g(0);
>> g(100000);
n := 5;
d := [];
(i := 0; i < n; i := i + 1;) @ { d :+ n; (i < 3) ? n := n + 1; }
>> d;
w := [];
(i := -2147483647; i < 2147483647; i := i + 1;) @ { w :+ i; (|w| = 3) ? i := 2147483646; }
>> w;
