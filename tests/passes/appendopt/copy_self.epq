// copying from the list itself (same list, directly and through an alias / parameter)
l := [1, 2, 3];
(i := 0; i < 3; i := i + 1;) @ { l :+ l[i]; }
>> l;
k := l;
(i := 1; i < 5; i := i + 1;) @ { l :+ k[i]; }
>> l;
>> k;
g := (a, b, n) => {
  (i := 0; i < n; i := i + 1;) @ { a :+ b[i]; }
  => a;
};
x := [7, 8];
>> g(x, x, 4);
y := [9];
>> g(y, [4, 5, 6], 3);
