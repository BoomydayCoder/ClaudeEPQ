// byte lists compared with int lists and with each other (=, !=, <, >, <=, >=)
// bytes: yes
a := [1, 2, 3]; // FLAG
b := [1, 2, 300];
c := [1, 2, 3];
d := [1, 2];
e := [];
(i := 0; i < 3; i := i + 1;) @ e :+ 1000 * i;
>> a = c;
>> a = b;
>> a != b;
>> a < b;
>> b < a;
>> a > d;
>> d < a;
>> a <= c;
>> a >= c;
>> a < e;
>> e < a;
>> a = e;
z := [1, 2, 3, 0];
>> a < z;
>> z > a;
>> a = [1, 2, 3];
>> a = [1, 2, 4];
>> a != [];
>> a < [1, 2, 3, 4];
>> [1, 2, 2] < a;
q := [9];
(i := 0; i < 2; i := i + 1;) @ q :+ i;
>> q > a;
>> q = [9, 0, 1];
