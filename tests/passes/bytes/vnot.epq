// stores of !x, comparisons and abs
// bytes: no (abs is not in range by the rule)
f := [0, 0, 1, 1]; // FLAG
(i := 0; i < 40; i := i + 1;) @ f :+ (i < 20);
x := 5;
c := 0;
(x : f) @ c := c + x;
>> c;
>> f;
f[3] := !x; f[2] := (x = 5); f[1] := |0 - x|;
>> f;
>> f[3];
c := 0;
(x : f) @ c := c + x;
>> c;
>> f[1] = 5;
