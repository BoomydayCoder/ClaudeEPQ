// stores of !x and comparisons only (bytes: yes)
// bytes: yes
f := [0, 0, 1, 1]; // FLAG
(i := 0; i < 40; i := i + 1;) @ f :+ (i < 20);
x := 5;
c := 0;
(x : f) @ c := c + x;
>> c;
>> f;
f[3] := !x; f[2] := (x = 5); f[1] := (x < 3) = (x > 9); f[0] := !(f[3]);
>> f;
>> f[3];
c := 0;
(x : f) @ c := c + x;
>> c;

