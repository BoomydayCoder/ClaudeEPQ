// a store of a global holding only 0/1, from a function (bytes: yes)
// bytes: yes
f := [0, 0, 1, 1]; // FLAG
(i := 0; i < 40; i := i + 1;) @ f :+ (i < 20);
G := 1; put := () => { f[3] := G; G := 0; };
c := 0;
(x : f) @ c := c + x;
>> c;
>> f;
put(); put();
>> f;
>> f[3];
c := 0;
(x : f) @ c := c + x;
>> c;

