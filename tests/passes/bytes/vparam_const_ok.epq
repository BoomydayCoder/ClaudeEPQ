// a function storing a constant into a list parameter (bytes: yes)
// bytes: yes
f := [0, 0, 1, 1]; // FLAG
(i := 0; i < 40; i := i + 1;) @ f :+ (i < 20);
mark := (l, i) => { l[i] := 1; };
c := 0;
(x : f) @ c := c + x;
>> c;
>> f;
mark(f, 3); mark(f, 0);
>> f;
>> f[3];
c := 0;
(x : f) @ c := c + x;
>> c;

