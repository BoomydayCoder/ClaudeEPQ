// a store of a function result that is always 0..255 (bytes: yes)
// bytes: yes
f := [0, 0, 1, 1]; // FLAG
(i := 0; i < 40; i := i + 1;) @ f :+ (i < 20);
small := (x) => { (x > 2) ? => 200; => 1; };
c := 0;
(x : f) @ c := c + x;
>> c;
>> f;
f[3] := small(5); f[2] := small(1);
>> f;
>> f[3];
c := 0;
(x : f) @ c := c + x;
>> c;

