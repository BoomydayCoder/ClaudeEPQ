// temporary byte lists and int lists in loops: freed memory reused by the other kind
// bytes: yes
t := 0;
(r := 0; r < 200; r := r + 1;) @ {
    fl := [0, 0, 0, 0, 0, 0, 0, 0]; // FLAG
    (i := 0; i < 8; i := i + 2;) @ fl[i] := 1;
    big := [r, r * 1000, r * 100000, 7, 8, 9, 10, 11];
    s := 0;
    (i := 0; i < 8; i := i + 1;) @ s := s + fl[i] * big[i];
    t := t + s;
    tmp := [];
    (i := 0; i < 40; i := i + 1;) @ tmp :+ (i < r);
    t := t + |tmp| + tmp[39];
    w := [];
    (i := 0; i < 40; i := i + 1;) @ w :+ i * r;
    t := t + w[39];
}
>> t;
