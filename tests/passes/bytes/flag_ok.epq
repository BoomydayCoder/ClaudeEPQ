// a sieve's flag list: every stored value is 0 or 1 -> byte region
// bytes: yes
n := 1000;
f := [0, 0]; // FLAG
(i := 2; i <= n; i := i + 1;) @ f :+ 1;
(i := 2; i * i <= n; i := i + 1;) @ (f[i]) ? {
    (j := i * i; j <= n; j := j + i;) @ f[j] := 0;
}
c := 0;
(i := 0; i <= n; i := i + 1;) @ c := c + f[i];
>> c;
s := [];
(i := 0; i < 30; i := i + 1;) @ s :+ f[i];
>> s;
>> f[997];
>> f[999];
