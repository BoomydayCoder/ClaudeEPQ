cnt := 0;
q := () => { cnt := cnt + 1; => cnt; };
f := () => {
  l := [11];
  m := [1, 2, 3, 4, 5, 6, 7, 8];
  n := |l|;
  a := 4;
  b := 1;
  c := 1;
  d := 1;
  (i := 0; i < n; i := i + 1;) @ {
    ((5 + (7 + l[i])) >= ((i + b) * (d * c))) ? { b := c; a := (i * 5); }
    (b = (3 + (d + i))) ? a := d;
    (i + 2 < n & l[i + 2] > d) ? { a := d; a := ((a * i) - i); b := a; d := d; }
    >> [a, b, c, d];
  }
  >> [a, b, c, d];
  >> l;
  => a + b;
};
>> f();
>> cnt;
