cnt := 0;
q := () => { cnt := cnt + 1; => cnt; };
l := [14, -7, 9, 0, -8, -2, -3];
m := [1, 2, 3, 4, 5, 6, 7, 8];
n := |l|;
a := 2;
b := 1;
c := 4;
d := -3;
(i := 0; i < n; i := i + 1;) @ {
  t := l[i] + 0;
  (l[i] > ((i * l[i]) * (0 - i))) ? d := (c * (a * i));
  (i < n & l[i] <= ((a * c) + (l[i] + -5))) ? { c := (l[i] - (6 - b)) / (d); d := l[i]; }
  >> [a, b, c, d];
}
>> [a, b, c, d];
>> l;
>> cnt;
