cnt := 0;
q := () => { cnt := cnt + 1; => cnt; };
f := () => {
  l := [2, -1, 18];
  m := [1, 2, 3, 4, 5, 6, 7, 8];
  n := |l|;
  a := -3;
  b := 0;
  c := -1;
  d := 2;
  (i := 0; i < n; i := i + 1;) @ {
    t := l[i] + 0;
  (l[i] > l[i]) ? { b := ((i + i) - d); b := ((l[i] + 5) + (i + 5)); d := ((l[i] - a) * l[i]) / (7); b := i; }
    (l[i] >= (d - (i * b))) ? { c := (i - 4); }
    t := l[i] + 0;
  ((i - 5) >= (l[i] + (c * l[i]))) ? { a := ((c - c) + (d - b)); b := a; b := ((b * i) - (d + i)); d := ((2 - 6) - l[i]); }
    >> [a, b, c, d];
  }
  >> [a, b, c, d];
  >> l;
  => a + b;
};
>> f();
>> cnt;
