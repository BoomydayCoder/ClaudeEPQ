cnt := 0;
q := () => { cnt := cnt + 1; => cnt; };
l := [17, 11, -9, -4, 6, 7, -1, 14, -8];
m := [1, 2, 3, 4, 5, 6, 7, 8];
n := |l|;
a := -2;
b := 4;
c := -1;
d := -1;
(i := 0; i < n; i := i + 1;) @ {
  ((l[i] + (c + l[i])) > ((a - i) + -5)) ? { b := l[i + 2]; d := ((l[i] + c) - c); b := (a - (d + d)); }
  t := l[i] + 0;
  (l[i] != ((i * i) * d)) ? a := a;
  t := l[i] + 0;
  (l[i] = (a * (d * i))) ? d := l[i + 3];
  >> [a, b, c, d];
}
>> [a, b, c, d];
>> l;
>> cnt;
