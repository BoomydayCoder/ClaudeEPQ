cnt := 0;
q := () => { cnt := cnt + 1; => cnt; };
l := [1];
m := [1, 2, 3, 4, 5, 6, 7, 8];
n := |l|;
a := -3;
b := 1;
c := -1;
d := 0;
(i := 0; i < n; i := i + 1;) @ {
  t := l[i] + 0;
  ((q()) <= b) ? { c := (c * (l[i] * c)); b := (i - (i + a)); l[i] := (c + (1 + 5)); l[i] := i; }
  (l[i] <= l[i]) ? { b := (4 + (c + l[i])); a := 4; b := ((a * d) - (d - l[i])); -m; }
  (l[i] = -4) ? { d := ((d + c) + b); c := ((i - i) + i); d := (i - d); }
  >> [a, b, c, d];
}
>> [a, b, c, d];
>> l;
>> cnt;
