cnt := 0;
q := () => { cnt := cnt + 1; => cnt; };
f := () => {
  l := [11, 10, -4, 19, 18, -9];
  m := [1, 2, 3, 4, 5, 6, 7, 8];
  n := |l|;
  a := -3;
  b := -3;
  c := -1;
  d := -3;
  (i := 0; i < n; i := i + 1;) @ {
    t := l[i] + 0;
  (l[i] < ((i + 3) - i)) ? { c := a; c := ((c + c) + (i - a)); c := l[i]; a := d; }
    (i >= d | i >= a) ? { c := c; }
    (i + 2 < n & l[i + 2] <= (i - i)) ? { a := ((c + 7) - -5); b := ((d - a) + (2 - l[i])); }
    >> [a, b, c, d];
  }
  >> [a, b, c, d];
  >> l;
  => a + b;
};
>> f();
>> cnt;
