cnt := 0;
q := () => { cnt := cnt + 1; => cnt; };
l := [11, 0, 12, -5, -6];
m := [1, 2, 3, 4, 5, 6, 7, 8];
n := |l|;
a := -1;
b := 3;
c := -3;
d := -3;
(i := 0; i < n; i := i + 1;) @ {
  (-4 != c) ? { a := 2; }
  (((a * i) + (i * b)) <= l[i]) ? { c := ((a - 0) + i); c := (-4 * (i + c)); d := l[i]; -m; }
  t := l[i] + 0;
  ((0 * (6 + l[i])) <= (i - c)) ? { d := -5; a := (i - (i + l[i])); d := l[i + 1]; -m; }
  >> [a, b, c, d];
}
>> [a, b, c, d];
>> l;
>> cnt;
