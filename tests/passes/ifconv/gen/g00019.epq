cnt := 0;
q := () => { cnt := cnt + 1; => cnt; };
l := [13, 3, -4, 8, 19, -5, 15];
m := [1, 2, 3, 4, 5, 6, 7, 8];
n := |l|;
a := -2;
b := 1;
c := -3;
d := 1;
(i := 0; i < n; i := i + 1;) @ {
  t := l[i] + 0;
  ((q()) >= l[i]) ? { b := b; b := l[i]; d := l[i]; d := a / (b); }
  t := l[i] + 0;
  (d >= l[i] | -2 >= d) ? { l[i] := l[i]; c := l[i + 1]; b := l[i + 2]; b := ((a - l[i]) - (a * a)) / (l[i]); }
  ((q()) = d) ? { c := b; }
  >> [a, b, c, d];
}
>> [a, b, c, d];
>> l;
>> cnt;
