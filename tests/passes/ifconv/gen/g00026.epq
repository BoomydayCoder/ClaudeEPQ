cnt := 0;
q := () => { cnt := cnt + 1; => cnt; };
f := () => {
  l := [9, 5, 0];
  m := [1, 2, 3, 4, 5, 6, 7, 8];
  n := |l|;
  a := -1;
  b := 3;
  c := -1;
  d := 4;
  (i := 0; i < n; i := i + 1;) @ {
    t := l[i] + 0;
  (((b * c) - (c + l[i])) < (9 - b)) ? b := ((b - l[i]) - (b * a));
    (l[i] >= d) ? { b := l[i]; b := l[i]; }
    (i + 2 < n & l[i + 2] < ((c + d) + (i + c))) ? { c := ((d * l[i]) - (c * -1)); }
    >> [a, b, c, d];
  }
  >> [a, b, c, d];
  >> l;
  => a + b;
};
>> f();
>> cnt;
