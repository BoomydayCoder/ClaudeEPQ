cnt := 0;
q := () => { cnt := cnt + 1; => cnt; };
l := [4, 14, 14, -7, -1, -1];
m := [1, 2, 3, 4, 5, 6, 7, 8];
n := |l|;
a := 1;
b := 0;
c := -3;
d := 0;
(i := 0; i < n; i := i + 1;) @ {
  t := l[i] + 0;
  (i < n & l[i] <= ((d + a) + b)) ? { c := (d - i); a := ((b * c) - (i - a)); a := l[i]; }
  >> [a, b, c, d];
}
>> [a, b, c, d];
>> l;
>> cnt;
