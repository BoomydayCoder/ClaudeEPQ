cnt := 0;
q := () => { cnt := cnt + 1; => cnt; };
f := () => {
  l := [13, 10, -9, -2, 5];
  m := [1, 2, 3, 4, 5, 6, 7, 8];
  n := |l|;
  a := 1;
  b := 1;
  c := 3;
  d := 0;
  (i := 0; i < n; i := i + 1;) @ {
    ((q()) >= i) ? { a := ((i - a) - i); b := (b - a); }
    (d != 3 | 5 > 4) ? { b := ((0 - l[i]) + (c + 3)); a := ((d - i) + (l[i] - i)); b := l[i + 0]; }
    t := l[i] + 0;
  (b = ((i - l[i]) - (l[i] - i))) ? d := ((b - a) + (c - b));
    >> [a, b, c, d];
  }
  >> [a, b, c, d];
  >> l;
  => a + b;
};
>> f();
>> cnt;
