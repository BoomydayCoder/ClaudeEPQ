cnt := 0;
q := () => { cnt := cnt + 1; => cnt; };
l := [-1];
m := [1, 2, 3, 4, 5, 6, 7, 8];
n := |l|;
a := -3;
b := 3;
c := -2;
d := 0;
(i := 0; i < n; i := i + 1;) @ {
  (i + 1 < n & l[i + 1] > ((-2 - b) + (i + 7))) ? { a := b; }
  t := l[i] + 0;
  (((b * l[i]) - l[i]) = ((i + b) + l[i])) ? { a := b; }
  (i + 1 < n & l[i + 1] <= b) ? { b := l[i]; c := (i - (a + d)); b := a; d := a / (a); }
  >> [a, b, c, d];
}
>> [a, b, c, d];
>> l;
>> cnt;
