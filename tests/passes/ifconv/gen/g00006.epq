cnt := 0;
q := () => { cnt := cnt + 1; => cnt; };
l := [-4, -8, 19, 3, 4, 8, 13, 0, 5];
m := [1, 2, 3, 4, 5, 6, 7, 8];
n := |l|;
a := 2;
b := 0;
c := -2;
d := 1;
(i := 0; i < n; i := i + 1;) @ {
  (l[i] != (i * (a + 3))) ? { b := ((b * -1) + l[i]); a := ((i + b) - (-2 + b)); }
  (i + 2 < n & l[i + 2] = a) ? { b := ((a - -1) - c); b := 6; d := l[i]; }
  >> [a, b, c, d];
}
>> [a, b, c, d];
>> l;
>> cnt;
