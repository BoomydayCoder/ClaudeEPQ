cnt := 0;
q := () => { cnt := cnt + 1; => cnt; };
f := () => {
  l := [5, 16, -9, 0, -6, -9, 8];
  m := [1, 2, 3, 4, 5, 6, 7, 8];
  n := |l|;
  a := -1;
  b := 2;
  c := 1;
  d := -3;
  (i := 0; i < n; i := i + 1;) @ {
    t := l[i] + 0;
  (i < d | l[i] > -1) ? { d := (i - (c + l[i])) / (l[i]); }
    (l[i] > ((i + b) * l[i])) ? { a := i; c := ((l[i] * c) - a); }
    >> [a, b, c, d];
  }
  >> [a, b, c, d];
  >> l;
  => a + b;
};
>> f();
>> cnt;
