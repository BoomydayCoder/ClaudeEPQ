cnt := 0;
q := () => { cnt := cnt + 1; => cnt; };
f := () => {
  l := [15, 2, 15];
  m := [1, 2, 3, 4, 5, 6, 7, 8];
  n := |l|;
  a := 3;
  b := -2;
  c := 2;
  d := -3;
  (i := 0; i < n; i := i + 1;) @ {
    t := l[i] + 0;
  (((b - b) - (-1 + l[i])) != ((d - 3) - l[i])) ? { c := ((b - -3) - (i * b)); b := ((-5 + l[i]) * d); d := ((a - l[i]) + 2); d := a; }
    >> [a, b, c, d];
  }
  >> [a, b, c, d];
  >> l;
  => a + b;
};
>> f();
>> cnt;
