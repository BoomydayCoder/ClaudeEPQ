c := -2;
d := 0;
(i := 0; i < n; i := i + 1;) @ {
  (((2 + l[i]) * (b + c)) > i) ? { a := ((c + i) + (c + 4)); d := ((d * l[i]) - (c * d)); }
  t := l[i] + 0;
  (l[i] < i) ? { a := l[i]; a := b; }
  (l[i] > d) ? { a := l[i]; c := ((2 * i) + (i - c)); c := ((b - i) - (b - l[i])); d := ((b + i) * (i - l[i])); }
