cnt := 0;
q := () => { cnt := cnt + 1; => cnt; };
l := [8, 8, 4, 5, 7, 5, 8, 0];
m := [1, 2, 3, 4, 5, 6, 7, 8];
n := |l|;
a := 4;
b := -3;
c := 4;
d := 0;
(i := 0; i < n; i := i + 1;) @ {
  (i + 2 < n & l[i + 2] >= c) ? { a := ((b - 0) - b); -m; l[i] := ((i + l[i]) + (7 + -2)); a := ((d * c) + (i + l[i])); }
  (l[i] >= ((d - b) - (c + d))) ? d := (b - 0);
  (i < n & l[i] > (c + (c + -4))) ? { a := b; a := ((c + l[i]) + a); }
  >> [a, b, c, d];
}
>> [a, b, c, d];
>> l;
>> cnt;
