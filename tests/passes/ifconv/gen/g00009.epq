cnt := 0;
q := () => { cnt := cnt + 1; => cnt; };
l := [8];
m := [1, 2, 3, 4, 5, 6, 7, 8];
n := |l|;
a := 0;
b := -1;
c := -2;
d := 4;
(i := 0; i < n; i := i + 1;) @ {
  ((a - 8) = ((l[i] - d) + 2)) ? { a := i; b := (c + c); c := d / (l[i]); }
  (i < n & l[i] = ((l[i] - c) + (a + i))) ? d := (b - i);
  >> [a, b, c, d];
}
>> [a, b, c, d];
>> l;
>> cnt;
