cnt := 0;
q := () => { cnt := cnt + 1; => cnt; };
l := [2, -6, 6, 1];
m := [1, 2, 3, 4, 5, 6, 7, 8];
n := |l|;
a := -3;
b := -3;
c := 1;
d := 3;
(i := 0; i < n; i := i + 1;) @ {
  (l[i] < a) ? { d := ((i - b) - d); b := c; d := (d + (1 - c)); }
  (((d + d) * c) >= ((i * l[i]) - (l[i] + b))) ? { b := b; b := ((d - l[i]) - (a - i)); d := ((b * l[i]) + (d - l[i])); }
  >> [a, b, c, d];
}
>> [a, b, c, d];
>> l;
>> cnt;
