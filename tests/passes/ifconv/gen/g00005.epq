cnt := 0;
q := () => { cnt := cnt + 1; => cnt; };
l := [7, 7, -2];
m := [1, 2, 3, 4, 5, 6, 7, 8];
n := |l|;
a := 0;
b := 1;
c := -3;
d := 3;
(i := 0; i < n; i := i + 1;) @ {
  (i + 1 < n & l[i + 1] < ((l[i] + i) + (l[i] * a))) ? { d := ((l[i] - i) - i); b := ((l[i] * 2) - a); c := ((i - b) - (c - -5)); }
  >> [a, b, c, d];
}
>> [a, b, c, d];
>> l;
>> cnt;
