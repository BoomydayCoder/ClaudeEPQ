cnt := 0;
q := () => { cnt := cnt + 1; => cnt; };
l := [-8, 4, 15, -4, 12, 0];
m := [1, 2, 3, 4, 5, 6, 7, 8];
n := |l|;
a := 0;
b := -3;
c := -3;
d := 3;
(i := 0; i < n; i := i + 1;) @ {
  t := l[i] + 0;
  (-4 <= b) ? b := i;
  (d >= -2 | 3 != c) ? b := (i - (a + d));
  >> [a, b, c, d];
}
>> [a, b, c, d];
>> l;
>> cnt;
