cnt := 0;
q := () => { cnt := cnt + 1; => cnt; };
f := () => {
  l := [-1, -2, 19, 17, 3, 2, 18, 5, 4];
  m := [1, 2, 3, 4, 5, 6, 7, 8];
  n := |l|;
  a := 1;
  b := 4;
  c := 4;
  d := 0;
  (i := 0; i < n; i := i + 1;) @ {
    t := l[i] + 0;
  (l[i] != a) ? { a := c; b := c; c := d; }
    (5 >= l[i] | d > b) ? { l[i] := i; a := ((a + l[i]) + (i + c)); d := l[i + 2]; c := (l[i] - c); }
    (l[i] != 0) ? { b := d; d := d; }
    >> [a, b, c, d];
  }
  >> [a, b, c, d];
  >> l;
  => a + b;
};
>> f();
>> cnt;
