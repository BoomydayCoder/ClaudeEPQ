// pair-typed values (if the pairs pass unboxes them) under conditional assignment
ps := [[3, 1], [1, 9], [3, 0], [2, 2], [1, 9]];
best := ps[0];
(i := 0; i < |ps|; i := i + 1;) @ {
  (ps[i] < best) ? best := ps[i];
}
>> best;
lo := [9, 9];
(i := 0; i < |ps|; i := i + 1;) @ {
  p := ps[i];
  (p[0] + p[1] < lo[0] + lo[1]) ? lo := p;
}
>> lo;
