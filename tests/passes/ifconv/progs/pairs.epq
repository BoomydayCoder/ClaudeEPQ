// pair-like values: lists of two ints, lexicographic compare and selection
ps := [[3, 1], [1, 9], [3, 0], [2, 2], [1, 8], [3, 0]];
best := ps[0];
(i := 0; i < |ps|; i := i + 1;) @ {
  p := ps[i];
  (p < best) ? best := p;
}
>> best;
n := |ps|;
(i := 0; i < n; i := i + 1;) @ {
  (j := 0; j < n - i - 1; j := j + 1;) @ {
    (ps[j] > ps[j + 1]) ? { t := ps[j]; ps[j] := ps[j + 1]; ps[j + 1] := t; }
  }
}
>> ps;
