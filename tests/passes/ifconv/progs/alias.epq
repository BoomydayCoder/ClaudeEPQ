// same list through two locals; body statements depending on earlier ones
a := [1, 2, 3, 4, 5];
b := a;
(i := 0; i < 4; i := i + 1;) @ {
  (a[i] < b[i + 1]) ? {
    a[i + 1] := b[i] + 100;
    b[i] := a[i + 1] - 1;
    a[i] := a[i] + b[i];
  }
}
>> a; >> b;
x := 0; y := 0;
(i := 0; i < 5; i := i + 1;) @ {
  (i > 1) ? { x := i; y := x + y; x := y * 2; }
}
>> x; >> y;
