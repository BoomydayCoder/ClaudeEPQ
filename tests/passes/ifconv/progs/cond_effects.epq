// conditions with side effects (assignments, input, calls) and evaluation order
f := (x) => { >> x; => x * 2; };
l := [3, 1, 4, 1, 5];
c := 0;
(i := 0; i < 4; i := i + 1;) @ {
  ((c := c + 1) > 2) ? c := c * 10;
  (f(l[i]) > 4) ? l[i] := 0;
  (l[i + 1] > i) ? l[i + 1] := l[i + 1] + 1;
  ((x := << ) > 2) ? c := c + x;
}
>> c; >> l;
