// bubblesort with the hand-inlined swap (element stores: off by default, EPQ_IFCONV_STORES=1 converts)
l := [5, 3, 9, 1, 7, 2, 8, 2, -4, 0];
n := |l|;
(i := 0; i < n; i := i + 1;) @ {
  (j := 0; j < n - i - 1; j := j + 1;) @ {
    (l[j] > l[j + 1]) ? {
      temp := l[j];
      l[j] := l[j + 1];
      l[j + 1] := temp;
    }
    p := j + 1;
    (l[j] > l[p]) ? { t2 := l[j]; l[j] := l[p]; l[p] := t2; }
  }
}
>> l;
// store whose index is not established: must stay guarded
m := [1, 2, 3];
(i := 0; i < 5; i := i + 1;) @ {
  (m[0] > 0 & i < 3) ? m[i] := m[0] + i;
  (i = 4) ? m[i] := 1;
}
