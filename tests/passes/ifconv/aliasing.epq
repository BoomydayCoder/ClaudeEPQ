// same list through two locals; store through one, conditional read through the other
a := [1, 2, 3, 4, 5];
b := a;
m := 0;
(i := 0; i < 4; i := i + 1;) @ {
  (a[i] > m) ? m := a[i];
  b[i + 1] := 0;
  (a[i + 1] < 10) ? m := m + a[i + 1];
}
>> m;
>> a;
c := [5, 6];
(i := 0; i < 3; i := i + 1;) @ {
  v := c[0];
  -c;
  c :+ 1;
  (v > 0) ? m := m + c[0];
}
>> m;
>> c;
