// element reads only valid when the condition holds: must stay guarded
l := [1, 2, 3];
s := 0;
(i := 0; i < 6; i := i + 1;) @ {
  (i < |l|) ? s := s + l[i];
  (i < 3) ? s := s + l[2 - i] * 10;
  (i > 0 & i < 4) ? s := s + l[i - 1] * 100;
}
>> s;
(i := 0; i < 2; i := i + 1;) @ {
  (i = 1) ? s := l[5];
}
>> s;
