// the list local is reassigned between the access and the If
l := [10, 20, 30];
s := 0;
(i := 0; i < 3; i := i + 1;) @ {
  x := l[2];
  l := [1];
  (x > 0) ? s := s + l[0];
  l := [10, 20, 30];
}
>> s;
(i := 0; i < 2; i := i + 1;) @ {
  x := l[2];
  (x > 0) ? { l := [7]; s := s + l[0]; }
}
>> s;
>> l;
l := [10, 20, 30];
(i := 0; i < 2; i := i + 1;) @ {
  j := 2;
  x := l[j];
  j := j + 5 * i;
  (x > 0) ? s := s + l[j];
}
>> s;
