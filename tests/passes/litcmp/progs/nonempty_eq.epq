// x = [c1..ck] for an int list x; length test + element test, order of effects kept.
f := (x) => { >> x; => x; };
l := [];
(i := 0; i < 6; i := i + 1;) @ {
    >> [l = [0, 1], l != [0, 1], [0, 1, 2] = l, l = [0], l = [1], [0, 1, 2, 3] != l, l = [0, 1, 2, 3, 4]];
    l :+ i;
}
m := [3, 4];
a := 3;
>> m = [a, a + 1];
>> [a, 4] = m;
>> m = [4, 3];
>> f(m) = [3, 4];
>> [3, 4] = f(m);
>> [a, 4] != f(m);
>> [f(3), 4] = m;
z := [5];
>> [a] = (z);
>> a;
