// Any-element list equality fast path: identical words, functions, shared sublists.
f := (x) => { => x + 1; };
g := (x) => { => x + 2; };
s := [1, 2];
a := [f, s, 3, [], [f]];
b := [f, s, 3, [], [f]];
c := [f, [1, 2], 3, [], [f]];
d := [g, s, 3, [], [f]];
>> [a = b, a = c, a = d, a != d];
>> [a = a, [s] = [s], [s, s] = [[1, 2], s]];
s[0] := 9;
>> [a = c, a = b];
e := [[], [[]], [[], []]];
>> [e = [[], [[]], [[], []]], e != [[], [[]], [[]]]];
>> [e[0] = [], e[1] = [], e[1][0] = [], [] = e[2][1], e[2] != []];
>> [f = [], [] = g, 0 = [], [] != 7];
t := [[1, f], [1, g]];
>> t[0] = t[1];
p := [1, [2, [3, [4]]]];
>> p = [1, [2, [3, [4]]]];
>> p = [1, [2, [3, [5]]]];
>> p < [1, [2, [3, [5]]]];
