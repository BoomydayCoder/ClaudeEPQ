// x = [] / x != [] for every static type of x, literal on either side, with side effects.
f := (x) => { >> x; => x; };
g := (y) => { => y; };
a := [];
b := [1];
>> a = [];
>> b = [];
>> [] = a;
>> [] != b;
>> f(3) = [];
>> [] = f(4);
>> f([]) != [];
>> [] = f([[]]);
>> 5 = [];
>> 0 != [];
>> g = [];
>> [] != g;
d := [[1], 2, [], g, [[]]];
(e : d) @ { >> e = []; >> [] != e; }
>> d[2] = [];
>> d[1] = [];
>> d[0] != [];
>> [] = [];
>> [[]] = [[]];
>> [] = [[]];
c := [];
c :+ 7;
>> c = [];
>> -c;
>> c = [];
>> [] = c;
