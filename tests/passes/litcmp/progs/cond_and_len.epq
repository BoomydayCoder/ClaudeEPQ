// List literals as conditions and under |...|: elements still evaluated, in order.
f := (x) => { >> x; => x; };
([]) ? >> 1; : >> 0;
([f(1), f(2)]) ? >> 3; : >> 4;
n := 0;
([n := n + 1]) ? >> n;
i := 0;
([i] & i < 3) @ i := i + 1;
>> i;
>> |[]|;
>> |[1, 2, 3]|;
>> |[f(7), [f(8)], f(9)]|;
xx := [f(10), f(11)];
>> xx;
>> ([] | 5);
>> ([] & 5);
h := (a) => { [f(a), a]; [a]; => a; };
>> h(12);
k := 0;
(j := 0; j < 3; [k := k + j];) @ j := j + 1;
>> k;
d := [1, [2]];
(e : d) @ >> |[e, e]|;
