// Deep lexicographic compare: results, including prefixes and nesting.
mk := (d, v) => { (d = 0) ? => v; => [mk(d - 1, v), mk(d - 1, v)]; };
a := mk(12, 1);
b := mk(12, 1);
c := mk(12, 2);
>> [a < b, b < a, a <= b, a >= b, a < c, c < a, a = b, a = c];
p := [[1, 2], [3, [4, 5]], []];
q := [[1, 2], [3, [4, 6]]];
>> [p < q, q < p, p <= q, p > q];
r := [[1, 2], [3, [4, 5]]];
>> [p < r, r < p, r <= p, p >= r];
>> [[] < [[]], [[]] < [], [[1]] < [[1], 1], [[1], 1] < [[1]]];
g := (y) => { => y; };
>> [[1, g] < [2, g], [3] < [2, []], [g] = [g], [1, [g]] < [2, 0]];
x := [1, [2, [3, [g]]]];
>> x < [0, 1];
>> [x] < [[2, 0]];
