// Ordering against [] when x is statically a list; side effects and order kept.
f := (x) => { >> x; => x; };
a := [];
b := [1, 2];
>> a < [];
>> a <= [];
>> a > [];
>> a >= [];
>> b < [];
>> b <= [];
>> b > [];
>> b >= [];
>> [] < a;
>> [] <= a;
>> [] > a;
>> [] >= a;
>> [] < b;
>> [] <= b;
>> [] > b;
>> [] >= b;
>> f([5]) < [];
>> [] < f([6]);
>> f([]) >= [];
>> [] >= f([[]]);
(i := 0; i < 3; i := i + 1;) @ {
    l := [];
    (j := 0; j < i; j := j + 1;) @ l :+ j;
    >> [l < [], l <= [], l > [], l >= [], [] < l, [] <= l, [] > l, [] >= l];
}
