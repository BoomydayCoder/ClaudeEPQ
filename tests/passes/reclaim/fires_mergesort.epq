// reclaim should free left/right (and the sorted halves, guarded by SameList) in sort
merge := (a, b) => {
    i := 0; j := 0;
    out := [];
    (i < |a| & j < |b|) @ {
        (a[i] < b[j]) ? { out :+ a[i]; i := i + 1; } : { out :+ b[j]; j := j + 1; }
    }
    (i < |a|) @ { out :+ a[i]; i := i + 1; }
    (j < |b|) @ { out :+ b[j]; j := j + 1; }
    => out;
};
sort := (l) => {
    (|l| <= 1) ? => l;
    mid := |l| / 2;
    left := []; right := [];
    (i := 0; i < mid; i := i + 1;) @ left :+ l[i];
    (i := mid; i < |l|; i := i + 1;) @ right :+ l[i];
    sl := sort(left);
    => merge(sl, sort(right));
};
>> sort([5, 3, 9, 1, 7, 2, 8]);
data := [];
s := 75;
(i := 0; i < 3000; i := i + 1;) @ { s := (s * 75 + 74) - 65537 * ((s * 75 + 74) / 65537); data :+ s; }
r := sort(data);
chk := 0;
(x : r) @ chk := chk * 31 + x;
>> |r|;
>> chk;
>> data[0];
>> data[2999];
