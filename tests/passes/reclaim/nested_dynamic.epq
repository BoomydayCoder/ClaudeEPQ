// list of lists: inner lists outlive the outer; dynamic values; for-each
f := () => { inner := [1, 2]; outer := [inner, [3]]; => outer[0]; };
g := () => { a := [[1], [2]]; r := []; (x : a) @ r :+ x; => r; };
d := (x) => { a := [x, [1]]; => a[1]; };
e := () => { a := [1, 2]; b := [a, 1]; => b[0]; };
pp := () => { a := [[5], [6]]; v := a[1]; => v; };
q := () => { a := [[5], [6]]; => a :+ [7]; };
x1 := f(); s := [50, 50]; >> x1;
x2 := g(); s := [51, 51]; >> x2;
x3 := d(4); s := [52, 52]; >> x3;
x4 := d([4]); s := [53]; >> x4;
x5 := e(); s := [54, 54, 54]; >> x5;
x6 := pp(); s := [55, 55]; >> x6;
x7 := q(); s := [56]; >> x7;
x1 :+ 1; x2[0] :+ 2; x6 :+ 3;
>> [x1, x2, x3, x4, x5, x6, x7];
