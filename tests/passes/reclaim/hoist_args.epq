// list-valued call arguments (calls and literals) are hoisted into temporaries;
// the callee may return them, store them, or only read them
first := (a, b) => { => a; };
sum := (l) => { s := 0; (x : l) @ s := s + x; => s; };
cat := (a, b) => { out := []; (x : a) @ out :+ x; (x : b) @ out :+ x; => out; };
G := [];
st := (l) => { G :+ l; => |l|; };
mk := (n) => { r := []; (i := 0; i < n; i := i + 1;) @ r :+ i * n; => r; };
f1 := () => { => first(mk(2), mk(3)); };
f2 := () => { => sum(mk(4)) + sum([1, 2, 3]); };
f3 := () => { => cat(cat(mk(2), [7]), mk(3)); };
f4 := () => { => st(mk(5)) + st([9, 9]); };
f5 := () => { x := sum(first([1], [2])) + sum(first(mk(3), mk(4))); => x; };
f6 := () => { => [sum(mk(3)), first(mk(1), [5])]; };
a1 := f1(); s := [60, 60, 60]; >> a1;
>> f2();
a3 := f3(); s := [61, 61]; >> a3;
>> f4(); s := [62, 62, 62, 62, 62]; >> G;
>> f5();
a6 := f6(); s := [63, 63]; >> a6;
a1 :+ 1; a3 :+ 2; a6[1] :+ 3; G[0] :+ 4;
>> [a1, a3, a6, G];
