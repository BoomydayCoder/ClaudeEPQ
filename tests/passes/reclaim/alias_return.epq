// returned through aliases, identities, two levels of calls, conditional returns
id := (x) => { => x; };
pick := (a, b, c) => { (c) ? => a; => b; };
f1 := () => { a := [1]; b := a; => b; };
g := () => { a := [1, 2, 3]; => a; };
h := () => { b := g(); => b; };
k := () => { c := h(); t := [0]; => c; };
f2 := () => { a := [1, 2]; b := id(a); c := id(b); => |c| + |a| + |b|; };
f3 := () => { a := [1, 2]; b := id(a); junk := [5]; => b; };
f4 := (c) => { a := [10]; b := [20]; (c) ? => a; => b; };
f5 := (c) => { x := [1]; y := [2]; z := pick(x, y, c); w := [5, 5]; => z; };
f6 := (c) => { x := [1]; y := [2]; z := pick(x, y, c); w := [5, 5]; => |z| + z[0]; };
f7 := () => { => pick(g(), g(), 0); };
f8 := () => { => id(id([4, 4])); };
r1 := f1(); s := [99, 99]; >> r1;
r2 := k(); s := [98, 98, 98]; >> r2;
>> f2(); s := [97]; >> s;
r3 := f3(); s := [96, 96]; >> r3;
r4 := f4(1); r5 := f4(0); s := [95, 95]; >> [r4, r5];
r6 := f5(1); r7 := f5(0); s := [94]; >> [r6, r7];
>> f6(1); >> f6(0);
r8 := f7(); s := [93, 93, 93]; >> r8;
r9 := f8(); s := [92, 92]; >> r9;
r8 :+ 1; r9 :+ 2; r1 :+ 3; >> [r1, r2, r3, r4, r5, r6, r7, r8, r9];
