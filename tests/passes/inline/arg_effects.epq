p := (v) => { >> v; => v; };
two := (a, b) => { => a * 10 + b; };
x := 1;
>> two(x, x := x + 1);
>> x;
>> two(x := x + 1, x);
>> two(x, two(x := 7, x));
>> x;
y := 3;
>> two(y, p(y := 4));
l := [5, 6];
first := (l2) => { => l2[0]; };
>> two(first(l), first(l := [8]));
>> l;
cnt := 0;
tick := () => { cnt := cnt + 1; => cnt; };
>> two(tick(), tick());
>> two(p(1), p(2) / p(0));
