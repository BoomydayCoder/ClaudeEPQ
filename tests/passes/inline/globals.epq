g := 1;
setg := (v) => { old := g; g := v; => old; };
readg := (x) => { => x + g; };
>> setg(5);
>> g;
>> readg(g);
>> readg(setg(10));
>> g;
useboth := (a, b) => { g := g + 1; => a * 100 + b; };
>> useboth(g, g);
>> g;
h := 7;
f := (a) => { h := 0; => a + h; };
>> f(h);
>> h;
lst := [1, 2, 3];
mut := (l) => { l :+ 4; lst := [9]; => |l|; };
>> mut(lst);
>> lst;
