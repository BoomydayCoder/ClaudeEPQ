p := (v) => { >> v; => v; };
gt := (a, b) => { >> a; => a > b; };
(p(0) & p(1)) ? { >> 10; } : { >> 11; }
(p(1) & p(0)) ? { >> 12; } : { >> 13; }
(p(1) | p(0)) ? { >> 14; } : { >> 15; }
(p(0) | p(2)) ? { >> 16; } : { >> 17; }
i := 0;
(gt(5, i) & gt(i, -1)) @ { i := i + 2; }
>> i;
>> p(0) & p(3);
>> p(4) | p(5);
>> p(0) | p(0) & p(6);
