mk := (n) => {
    out := [];
    (i := 0; i < n; i := i + 1;) @ { out :+ i * n; }
    s := 0;
    (e : out) @ { s := s + e; }
    out :+ s;
    => out;
};
all := [];
(k := 0; k < 5; k := k + 1;) @ { all :+ mk(k); }
>> all;
acc := (n) => { t := 0; (n > 0) @ { t := t + n; n := n - 1; } => t; };
x := 10;
>> acc(x);
>> x;
r := [];
(j : [3, 1, 4]) @ { r :+ acc(j); }
>> r;
