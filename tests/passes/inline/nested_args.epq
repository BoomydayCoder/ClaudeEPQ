mod := (a, b) => { => a - b * (a / b); };
p := (v) => { >> v; => v; };
add := (a, b) => { => a + b; };
>> mod(mod(1234567, 1000), mod(97, 60));
>> add(p(1), add(p(2), add(p(3), p(4))));
>> add(add(p(5), p(6)), p(7));
s := 0;
(i := 0; i < 1000; i := i + 1;) @ { s := mod(s * 31 + mod(i, 7), 65537); }
>> s;
>> mod(-7, 2);
>> mod(-2147483648, -1);
