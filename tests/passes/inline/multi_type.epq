id := (x) => { => x; };
fst := (l) => { => l[0]; };
both := (a, b) => { (a = b) ? { => a; } => b; };
>> id(3);
>> id([1, 2]);
>> id([[1], []]);
>> fst([4, 5]);
>> fst([[6], [7]]);
>> fst([[[8]]]);
>> both(1, 2);
>> both([1], [1]);
>> both([1], [2]);
f := id;
>> f(9);
>> f([3]);
g := (h, v) => { => h(v); };
>> g(id, 5);
>> g(fst, [6, 7]);
