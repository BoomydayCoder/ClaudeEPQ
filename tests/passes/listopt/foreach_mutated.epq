fm := () => {
    l := [1, 2, 3];
    (x : l) @ {
        >> x;
        (|l| < 6) ? l :+ x * 2;
    }
    >> l;
    a := l;
    (x : l) @ {
        >> x;
        -a;
    }
    >> l;
    b := [4, 5, 6];
    c := b;
    (x : b) @ {
        >> x;
        b := [9, 9, 9, 9, 9];
        c[0] := x + 1;
    }
    >> b;
    >> c;
};
fm();
