// induction variables incremented in the body (merge-style) and in adversarial ways
m := (a, b) => {
    p := 0; q := 0;
    out := [];
    (p < |a| & q < |b|) @ {
        (a[p] < b[q]) ? { out :+ a[p]; p := p + 1; } : { out :+ b[q]; q := q + 1; }
    }
    >> out;
    i := 0;
    (i < |a|) @ {
        >> a[i];
        i := i + 1;
        (i < |a|) ? >> a[i];
    }
    i := 0;
    (i < |a|) @ {
        i := i + 1;
        i := i + 1;
        >> a[i];
    }
};
m([1, 4, 6, 9], [2, 3, 10]);
