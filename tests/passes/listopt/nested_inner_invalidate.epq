nn := () => {
    l := [1, 2, 3];
    al := l;
    s := 0;
    (i := 0; i < 3; i := i + 1;) @ {
        (j := 0; j < |l|; j := j + 1;) @ {
            s := s + l[j];
            (j = 1) ? al :+ i;
        }
        >> s;
        (i = 1) ? { -al; -al; -al; }
        >> l[i];
    }
    >> l;
};
nn();
