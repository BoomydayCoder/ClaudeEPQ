// the same list passed as two parameters: appends/pops through y while indexing x
g := (x, y) => {
    t := 0;
    (i := 0; i < |x|; i := i + 1;) @ {
        t := t + x[i];
        (x[i] < 4) ? y :+ x[i] + 4;
    }
    >> t;
    >> x;
    k := 0;
    (k < |x|) @ {
        >> x[k];
        -y;
        k := k + 1;
    }
    >> x;
    => x[3];
};
l := [1, 2, 3];
>> g(l, l);
