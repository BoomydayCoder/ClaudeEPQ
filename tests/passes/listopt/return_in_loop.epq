find := (l, v) => {
    (i := 0; i < |l|; i := i + 1;) @ {
        (l[i] = v) ? => i;
    }
    => 0 - 1;
};
sw := (l, i, j) => { t := l[i]; l[i] := l[j]; l[j] := t; };
popn := (l, n) => { (k := 0; k < n; k := k + 1;) @ -l; };
rl := () => {
    l := [5, 3, 8, 1];
    >> find(l, 8);
    sw(l, 0, 3);
    >> l;
    (i := 0; i < |l|; i := i + 1;) @ {
        sw(l, i, |l| - 1);
        (i = 1) ? popn(l, 2);
        >> l;
    }
    sw(l, 0, 2);
};
rl();
