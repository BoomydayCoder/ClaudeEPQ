z := (n) => {
    l := [];
    s := 0;
    (i := 0; i < n; i := i + 1;) @ {
        s := s + l[i];
    }
    (x : l) @ s := s + x;
    (j := 0; j < |l|; j := j + 1;) @ {
        l[j] := 5;
    }
    >> s;
    >> l;
    l :+ 4;
    (i := 0; i < n; i := i + 1;) @ s := s + l[0];
    >> s;
};
z(0);
z(1);
z(2);
