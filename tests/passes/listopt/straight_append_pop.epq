// straight-line caches around direct Append/Pop on the cached list, and an
// out-of-bounds read right after a Pop shrank the list (fact must be dropped)
f := (l) => {
    >> l[0] + l[1];
    l :+ l[0] + 5;
    >> l[2] + l[|l| - 1];
    x := -l;
    >> x + l[0] + l[1];
    l :+ x;
    l :+ x + 1;
    >> l[3] + l[2] + |l|;
    -l; -l; -l;
    >> |l|;
    >> l[0] + l[1];
};
b := [1, 2];
out := [];
(i := 0; i < 5; i := i + 1;) @ out :+ i * 10;
>> out[0] + out[4];
k := 1;
>> b[k] + b[k - 1];
-b;
>> b[k - 1];
b :+ 9;
>> b[k];
a := [3, 4];
f(a);
>> a;
