pr := (x) => { >> x; => x; };
g0 := 1;
f0 := (d, p0) => {
    (d <= 0) ? => (p0 / ((5 + p0) * -3));
    p0 := p0 + g0;
    t := (p0 * (p0 + p0));
    (((t + p0) * (t + 7)) != (p0 - t)) ? => f0((d - 1), pr((((p0 + p0) - t) * ((t + t) + (d - 0)))));
    => f0((d - 1), p0);
};
f1 := (d, p0) => {
    (d <= 0) ? => (9 / 3);
    t := (((d - d) - (d / (p0 * p0 + 1))) / 3);
    (i := 0; i < 3; i := i + 1;) @ {
        (i != (i - 0)) ? => f1((d - 1), (t * (t + (t / 2))));
    }
    => f1((d - 2), p0);
};
>> f0(12, 0);
>> f0(12, 5);
>> f0(12, 13);
>> f1(22, 9);
>> f1(22, 13);
>> f1(22, 10);
>> g0;
