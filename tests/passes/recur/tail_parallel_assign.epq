// recur: the parallel-assignment trap: arguments read the parameters being overwritten
sw := (a, b, n) => {
    (n = 0) ? => a * 1000 + b;
    => sw(b, a, n - 1);
};
rot := (a, b, c, n) => {
    (n = 0) ? => [a, b, c];
    => rot(b, c, a, n - 1);
};
mix := (a, b, n) => {
    (n = 0) ? => [a, b];
    => mix(a + b, a - b, n - 1);
};
dup := (a, b, n) => {
    (n = 0) ? => [a, b];
    => dup(b, b, n - 1);
};
self := (a, b, n) => {
    (n = 0) ? => [a, b];
    => self(a, b + a, n - 1);
};
// argument expressions that assign the locals other arguments read
asg := (a, b, n) => {
    (n = 0) ? => [a, b];
    => asg(a := a + 1, a + b, n - 1);
};
>> sw(1, 2, 0);
>> sw(1, 2, 1);
>> sw(1, 2, 7);
>> rot(1, 2, 3, 1);
>> rot(1, 2, 3, 2);
>> rot(1, 2, 3, 3);
>> rot(1, 2, 3, 100);
>> mix(1, 2, 5);
>> mix(3, 1, 30);
>> dup(4, 5, 2);
>> self(3, 4, 5);
>> asg(1, 10, 3);
