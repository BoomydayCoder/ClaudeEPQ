pr := (x) => { >> x; => x; };
g0 := 1;
f0 := (d, p0, p1) => {
    (d <= 0) ? => (((p0 + p1) - p0) - ((p0 - 2) * (4 - p1)));
    g0 := g0 + 1;
    => f0((d - 1), p0, p0);
};
f1 := (d, p0, p1, p2) => {
    (d <= 0) ? => (p0 / ((p2 + p2) - (p2 / p1)));
    (i := 0; i < 3; i := i + 1;) @ {
        ((-3 + (p1 * -2)) < (i - 9)) ? => f1((d - 1), (p2 / d), p1, p0);
    }
    => f1((d - 2), (((d - p0) + p0) / 5), p2, (((p1 + p0) + p2) - (d + (d + p1))));
};
>> f0(21, 9, 20);
>> f1(20, 18, 15, -5);
>> f1(20, -3, 13, 6);
>> f1(20, 5, 16, 9);
>> g0;
