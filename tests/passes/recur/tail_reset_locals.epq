// recur: tail-call loops whose bodies define locals in nested scopes, loops
// and for-each loops (each new iteration must see fresh definitions)
f := (n) => {
    x := n * 3;
    (n > 3) ? { y := [n, x]; >> y; x := x + 1; }
    >> x;
    (n = 0) ? => 0;
    => f(n - 1);
};
>> f(6);
g := (n, acc) => {
    (i := 0; i < n; i := i + 1;) @ {
        t := i * 10;
        acc :+ t;
    }
    (n = 0) ? => acc;
    => g(n - 1, acc);
};
>> g(4, []);
h := (n, l) => {
    s := 0;
    (e : l) @ {
        s := s + e;
        (s > 20) ? => h(n - 1, [s - 20, n]);
    }
    >> [n, s];
    (n < 1) ? => s;
    => h(n - 1, l :+ n);
};
>> h(6, [3, 4]);
k := (n, m) => {
    (n = 0) ? {
        z := [m];
        => z;
    } : (n > 0) ? {
        z := m + n;
        => k(n - 1, z);
    } : {
        => [];
    }
};
>> k(10, 1);
>> k(-1, 1);
