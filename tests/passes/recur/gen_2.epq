pr := (x) => { >> x; => x; };
g0 := 0;
f0 := (d, p0) => {
    (d <= 0) ? => (((p0 * -1) - (5 - 4)) - ((p0 * p0) + p0));
    g0 := g0 + 1;
    t := (p0 + ((d * 3) * (p0 - 5)));
    (((p0 - p0) * (d + p0)) > (d + t)) ? => f0((d - 1), p0);
    => f0(d - 2, p0) * f0(d - 2, p0) * f0((d - 1), (t + ((7 + 0) - (t - d))));
};
>> f0(1, 17);
>> f0(1, -5);
>> f0(1, 7);
>> g0;
