// recur: tail calls in every statement position; look-alikes that are NOT tail calls
a := (n) => {
    (n < 0) ? => 100; : (n = 0) ? => 0; : (n = 1) ? { => a(n - 2); } : { => a(n - 3); }
};
w := (n, acc) => {
    (1) @ {
        (n = 0) ? => acc;
        (n > 50) ? => w(n - 50, acc + 1);
        n := n - 1;
        acc := acc + 2;
    }
};
fl := (n) => {
    (i := 0; i < 10; i := i + 1;) @ {
        (i = n) ? => fl(n - 1);
        (n < 0) ? => i * 7;
    }
    => -1;
};
fe := (n, l) => {
    (x : l) @ {
        (x = n) ? => fe(n - 1, l);
    }
    => n;
};
blk := (n) => {
    {
        {
            m := n * 2;
            (m > 10) ? => blk(n - 3);
        }
    }
    => n;
};
// not tail calls
plus0 := (n) => { (n = 0) ? => 1; => plus0(n - 1) + 0; };
neg := (n) => { (n = 0) ? => 1; => -neg(n - 1); };
andr := (n) => { (n = 0) ? => 5; => n & andr(n - 1); };
orr := (n) => { (n = 0) ? => 0; => (n - n) | orr(n - 1); };
andl := (n) => { (n = 0) ? => 0; => andl(n - 1) & n; };
lst := (n) => { (n = 0) ? => [0]; => [lst(n - 1)]; };
>> a(10);
>> a(11);
>> a(-5);
>> w(1000, 0);
>> w(7, 0);
>> fl(5);
>> fl(12);
>> fe(5, [1, 2, 3, 4, 5]);
>> fe(9, [9, 8, 1]);
>> blk(30);
>> plus0(1000);
>> neg(7);
>> neg(8);
>> andr(6);
>> orr(6);
>> andl(4);
>> lst(3);
