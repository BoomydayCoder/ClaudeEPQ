pr := (x) => { >> x; => x; };
g0 := 1;
f0 := (d, p0) => {
    (d <= 0) ? => 4;
    t := d;
    => f0((d - 1), p0) - f0((d - 1), p0) - f0((d - 1), pr(d));
};
f1 := (d, p0, p1, p2) => {
    (d <= 0) ? => p2;
    (i := 0; i < 3; i := i + 1;) @ {
        ((p1 + 2) != (p0 / p2)) ? => f1((d - 1), (((2 / 1) - (p2 + d)) + ((-1 / 2) + (p1 * 1))), (((p0 - p2) - (p2 + p2)) / ((d + p0) + (9 - d))), p2);
    }
    => f1((d - 2), p1, p0, d);
};
f2 := (d, p0, p1, p2) => {
    (d <= 0) ? => p2;
    t := (((1 - p2) * (p0 + p2)) + ((7 - d) - (p2 + p0)));
    => f2((d - 1), pr((((d / t) * (9 + p2)) * p0)), (-2 + ((p1 * p1) + (p2 + d))), (((d + p0) - (t - p1)) * (6 + (d - d))));
};
>> f0(3, 2);
>> f0(3, 6);
>> f0(3, 2);
>> f1(5, 3, 11, 0);
>> f2(12, -1, 5, -2);
>> g0;
