pr := (x) => { >> x; => x; };
g0 := 4;
f0 := (d, p0, p1, p2) => {
    (d <= 0) ? => (((p1 + p0) - (p1 - 0)) - 9);
    >> p2;
    t := p0;
    => f0((d - 1), t, ((p1 - p0) - (t * (d + p2))), 4);
};
f1 := (d, p0, p1) => {
    (d <= 0) ? => (((p0 + p0) / (p1 * p1 + 1)) + (p1 / (p0 + p1)));
    (i := 0; i < 3; i := i + 1;) @ {
        (p1 = p0) ? => f1((d - 1), (d / ((p1 + 4) + d)), pr(p0));
    }
    => f1((d - 2), (p0 + p1), p0);
};
>> f0(5, 3, -5, 18);
>> f1(16, 10, 17);
>> f1(16, 18, 5);
>> g0;
