f := (d) => {
    e := d[0];
    >> [e + 1, e - e, e * 0, e / 1, -e, |e|, !e, e = 1, e < 2, e > 2, e != 1, e = [1], 3 = 3, [1] = [1]];
    q := d[1];
    >> [q = [2], q < [3], |q|];
    => 0;
};
f([1, [2]]);
f([0 - 2147483647 - 1, [2, 3]]);
g := (x) => {
    >> x + 1;
    >> x / 1;
};
g(5);
g([1]);
