f := (l) => {
    (i := 0; i < |l| - 1; i := i + 1;) @ {
        (l[i] > l[i + 1]) ? {
            t := l[i];
            l[i] := l[i + 1];
            l[i + 1] := t;
        }
    }
    m := l[0];
    (x : l) @ { (1) ? { (x > m) ? m := x; } : m := 0; }
    (0) ? m := 0;
    (0) @ { m := 0; }
    (1 & 0) ? m := 0;
    ([] | 0) ? m := m + 1;
    => [l, m];
};
>> f([5, 3, 9, 1, 7]);
