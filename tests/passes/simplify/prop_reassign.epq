f := (p) => {
    x := 5;
    (i := 0; i < 3; i := i + 1;) @ {
        >> x;
        x := x + p;
    }
    >> x;
    y := p;
    p := p + 100;
    >> [y, p];
    z := 7;
    (p > 0) ? z := 8;
    >> z;
    w := 3;
    >> w;
    w := 4;
    >> w;
    q := p;
    >> q;
    => 0;
};
f(1);
f(0 - 200);
g := (a, b) => {
    c := a;
    d := c;
    e := 2147483647;
    >> [c, d, e + d, b - c];
    => d;
};
>> g(4, 9);
k := (n) => {
    v := 0;
    (n > 0) ? { v := 3; } : { v := 4; }
    >> v;
    u := 10;
    (j : [1, 2, 3]) @ { u := u + j; }
    >> u;
};
k(1);
k(0);
