f := (n) => {
    (i := 0; i < 10; i := i + 1;) @ {
        (i = n) ? {
            => i * 10;
            >> 999;
        }
        >> i;
    }
    => 0 - 1;
    >> 777;
};
>> f(3);
>> f(20);
g := (l) => {
    (x : l) @ {
        (x > 2) ? => x;
        : { >> x; }
    }
    => 0;
};
>> g([1, 2, 5, 7]);
h := (n) => {
    k := 0;
    (k < 100) @ {
        k := k + 1;
        (k = n) ? { => k; >> 0; }
    }
    => 0 - k;
};
>> h(5);
>> h(500);
