sq := (n) => { => n * n; };
inc := (n) => { => n + 1; };
f := (p) => {
    g := sq;
    >> g(p);
    h := inc;
    >> h(h(p));
    k := sq;
    >> k(p + 1);
    k := inc;
    >> k(p);
    (p > 2) ? k := sq;
    >> k(p);
    => g(h(p));
};
>> f(3);
>> f(1);
m := sq;
>> m(2147483647);
>> [m(7), sq(m(2))];
