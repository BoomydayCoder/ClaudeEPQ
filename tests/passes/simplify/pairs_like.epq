f := (n) => {
    p := [1, 2];
    q := [1, 3];
    r := [n, 0 - n];
    >> [p < q, p = q, p != q, q > p, p <= p, r[0], r[1], p[0] + q[1]];
    >> r;
    l := [];
    (i := 0; i < n; i := i + 1;) @ { l :+ [i, n - i]; }
    >> l;
    best := l[0];
    (x : l) @ { (x < best) ? best := x; }
    >> best;
};
f(4);
f(0 - 2147483647 - 1);
