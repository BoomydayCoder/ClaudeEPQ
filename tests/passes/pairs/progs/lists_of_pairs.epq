// lists of pairs (outer lists hold packed pairs): append, pop, set, print, compare, nest
h := [];
(i := 0; i < 6; i := i + 1;) @ h :+ [6 - i, i * i - 4];
>> h;
h[2] := [100, -100];
>> h[2];
t := -h;
>> t;
>> |h|;
>> h < [[6, -4], [5, -3]];
>> h = [[6, -4], [5, -3], [100, -100], [3, 5], [2, 12]];
nest := [h, [[1, 1]], []];
>> nest;
>> nest[0][1][0] + nest[1][0][1];
w := [[[1, 2], [3, 4]], [[5, 6]]];
>> w;
>> w[1][0] < w[0][1];
(e : h) @ >> e[0] * e[1];
mx := h[0];
(e : h) @ (e > mx) ? mx := e;
>> mx;
