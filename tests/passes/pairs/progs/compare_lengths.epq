// pairs compared with longer / shorter lists, ints, and lists of other regions
p := [1, 2];
a := [1, 2, 3];
b := [1];
c := [];
d := [1, 3];
d :+ 0;
>> [p < a, a < p, p < b, b < p, p = a, p = b, p < c, c < p, p = c];
>> [p < d, d < p, p = d, p != d];
>> p = 1;
>> 1 = p;
>> p != 7;
e := [1, 2];
e[0] := 1;
>> [p = e, e = p, p < e, e < p, p <= e, e >= p];
ll := [[1, 2], [1, 2, 0]];
>> [ll[0] = p, p < ll[1], ll[1] < p];
